{
	"segments": {
		"right": [
			{
				"function": "powerline.segments.common.sys.cpu_load_percent",
        "args" : {
          "format" : "cpu: {0:.0f}%"
        }
			},
			{
				"function": "powerline.segments.common.sys.uptime",
				"priority": 50
			},
			{
				"function": "powerline.segments.common.time.date",
        "name": "date",
        "args" : {
          "format": "%A",
          "istime": false
        }
			},
			{
				"function": "powerline.segments.common.time.date",
        "name": "date",
        "args" : {
          "format": "%d-%m-%Y",
          "istime": false
        }
			},
			{
				"function": "powerline.segments.common.time.date",
				"name": "time",
				"args": {
					"format": "%H:%M",
					"istime": true
				}
			},
			{
				"function": "powerline.segments.common.net.hostname"
			}
		]
	}
}
